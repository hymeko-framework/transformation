// meta_network.hymeko — vocabulary for describing computer networks in HyMeKo.
//
// Why a hypergraph is the right shape here. A broadcast segment does not
// relate two interfaces, it relates every interface attached to it at once;
// modelling a switched LAN as a set of pairwise cables loses exactly the fact
// that matters (that they share a collision/broadcast domain) and then has to
// reconstruct it. A firewall rule is likewise ternary at minimum — source,
// destination, service. Both are single hyperedges here.
//
// Signed incidence discipline, used consistently by every edge below:
//
//   +   the serving / upstream / source side
//   -   the served / downstream / destination side
//   ~   a peer, or a qualifier that is neither end
//
// So a segment reads `(+ router_port, ~ host_a, ~ host_b)`, a point-to-point
// link reads `(+ a_end, - z_end)`, and a rule reads
// `(+ source, - destination, ~ service)`.

meta_network
{

}

network {
    units {
        bandwidth "Mbit/s";
        latency "ms";
        mtu "bytes";
    }

    elements {
        // Everything that can take part in a connectivity or policy edge.
        meta_endpoint {}

        // A port on a device: what cables and segments actually attach to.
        interface: + <isa> meta_endpoint {}

        // A box: hosts interfaces, and may host services.
        device: + <isa> meta_endpoint {}

        // A listening endpoint on a device.
        service_instance: + <isa> meta_endpoint {}

        // An address range. Named so a rule can talk about a whole subnet.
        subnet: + <isa> meta_endpoint {}

        // Base hyperedges. Concrete kinds derive from these, so a query for
        // `link_definition` finds every kind of connectivity at once.
        @link_definition {}
        @policy_definition {}
        @routing_definition {}
    }

    devices {
        host:      + <isa> elements.device { role "host"; }
        server:    + <isa> elements.device { role "server"; }
        switch:    + <isa> elements.device { role "switch"; }
        router:    + <isa> elements.device { role "router"; }
        firewall:  + <isa> elements.device { role "firewall"; }
        access_point: + <isa> elements.device { role "wireless_ap"; }
    }

    media {
        medium_definition {}
        ethernet_1g:  + <isa> medium_definition { bandwidth 1000.0;  duplex "full"; mtu 1500; }
        ethernet_10g: + <isa> medium_definition { bandwidth 10000.0; duplex "full"; mtu 1500; }
        fiber_10g:    + <isa> medium_definition { bandwidth 10000.0; duplex "full"; mtu 9000; }
        wifi_5:       + <isa> medium_definition { bandwidth 866.0;   duplex "half"; mtu 1500; }
    }

    // ── Connectivity ──────────────────────────────────────────────────────
    // A segment is N-ary on purpose: every attached interface is a member of
    // the one edge, which is what a broadcast domain is.
    @segment:  + <isa> elements.link_definition {}
    // Exactly two ends. The grammar cannot enforce the arity, so the
    // convention is `(+ a_end, - z_end)` and a checker can assert it.
    @p2p_link: + <isa> elements.link_definition {}
    // A radio cell: the access point serves, the stations are peers.
    @wireless_cell: + <isa> elements.link_definition {}
    // A tagged trunk carrying several VLANs between two switch ports.
    @trunk:    + <isa> elements.link_definition {}

    protocols {
        protocol_definition {}
        icmp: + <isa> protocol_definition { number 1;  }
        tcp:  + <isa> protocol_definition { number 6;  }
        udp:  + <isa> protocol_definition { number 17; }
    }

    services {
        service_definition {}
        ssh:   + <isa> service_definition { port 22;  transport "tcp"; }
        dns:   + <isa> service_definition { port 53;  transport "udp"; }
        dhcp:  + <isa> service_definition { port 67;  transport "udp"; }
        http:  + <isa> service_definition { port 80;  transport "tcp"; }
        https: + <isa> service_definition { port 443; transport "tcp"; }
        ntp:   + <isa> service_definition { port 123; transport "udp"; }
    }

    zones {
        zone_definition {}
        trusted:   + <isa> zone_definition { level 2; }
        dmz:       + <isa> zone_definition { level 1; }
        untrusted: + <isa> zone_definition { level 0; }
    }

    // ── Policy ────────────────────────────────────────────────────────────
    // `(+ source, - destination, ~ service)`.
    @allow: + <isa> elements.policy_definition {}
    @deny:  + <isa> elements.policy_definition {}

    // ── Routing ───────────────────────────────────────────────────────────
    // `(+ next_hop, - destination_subnet)`.
    @route: + <isa> elements.routing_definition {}
}
