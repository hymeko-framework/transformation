// office_lan.hymeko — a small office network, described end to end.
//
// Three broadcast domains behind one router: a trusted office LAN, a wireless
// cell, and a DMZ holding the public web server. Each is a single hyperedge
// relating every interface attached to it, not a bag of pairwise cables.
//
// Reading the signs (see meta_network.hymeko):
//   +  the serving / upstream / source side
//   -  the served / downstream / destination side
//   ~  a peer, or a qualifier that is neither end

office_lan_description {
    @"meta_network.hymeko";

    using network          as nw;
    using network.devices  as dev;
    using network.elements as net;
    using network.media    as medium;
    using network.services as svc;
    using network.zones    as zone;

    const OFFICE_MTU = 1500;
}

office_lan: dev, net, medium, svc, zone {

    // ── Address space ─────────────────────────────────────────────────────
    office_net: net.subnet {
        cidr "10.10.0.0/24";
        gateway "10.10.0.1";
        vlan 10;
    }
    wifi_net: net.subnet {
        cidr "10.10.20.0/24";
        gateway "10.10.20.1";
        vlan 20;
    }
    dmz_net: net.subnet {
        cidr "192.0.2.0/28";
        gateway "192.0.2.1";
        vlan 30;
    }

    // ── The edge router ───────────────────────────────────────────────────
    gw: dev.router {
        vendor "generic";
        wan: net.interface {
            mac "02:00:00:00:00:01";
            address "198.51.100.7/30";
        }
        lan: net.interface {
            mac "02:00:00:00:00:02";
            address "10.10.0.1/24";
            mtu OFFICE_MTU;
        }
        wlan_uplink: net.interface {
            mac "02:00:00:00:00:03";
            address "10.10.20.1/24";
        }
        dmz_port: net.interface {
            mac "02:00:00:00:00:04";
            address "192.0.2.1/28";
        }
    }

    fw: dev.firewall {
        vendor "generic";
        inside: net.interface { mac "02:00:00:00:00:10"; }
        outside: net.interface { mac "02:00:00:00:00:11"; }
    }

    // ── Access layer ──────────────────────────────────────────────────────
    sw1: dev.switch {
        ports 24;
        uplink: net.interface { mac "02:00:00:00:01:00"; }
        p1: net.interface { mac "02:00:00:00:01:01"; }
        p2: net.interface { mac "02:00:00:00:01:02"; }
        p3: net.interface { mac "02:00:00:00:01:03"; }
    }

    ap1: dev.access_point {
        ssid "office";
        band "5GHz";
        wired: net.interface { mac "02:00:00:00:02:00"; }
        radio: net.interface { mac "02:00:00:00:02:01"; }
    }

    // ── Endpoints ─────────────────────────────────────────────────────────
    pc1: dev.host {
        os "linux";
        eth0: net.interface {
            mac "02:00:00:00:0a:01";
            address "10.10.0.11/24";
        }
    }

    pc2: dev.host {
        os "windows";
        eth0: net.interface {
            mac "02:00:00:00:0a:02";
            address "10.10.0.12/24";
        }
    }

    laptop: dev.host {
        os "macos";
        wlan0: net.interface {
            mac "02:00:00:00:0b:01";
            address "10.10.20.31/24";
        }
    }

    fileserver: dev.server {
        os "linux";
        eth0: net.interface {
            mac "02:00:00:00:0c:01";
            address "10.10.0.20/24";
        }
        sshd: net.service_instance {
            listens -> svc.ssh;
            bind "10.10.0.20";
        }
    }

    webserver: dev.server {
        os "linux";
        eth0: net.interface {
            mac "02:00:00:00:0d:01";
            address "192.0.2.10/28";
        }
        nginx: net.service_instance {
            listens -> svc.https;
            bind "192.0.2.10";
        }
    }

    // ── Connectivity ──────────────────────────────────────────────────────
    // The office LAN: one broadcast domain, five interfaces. The switch
    // uplink toward the router is the serving side; the access ports and the
    // hosts on them are peers.
    @office_segment: nw.segment {
        (+ gw.lan,
         ~ sw1.uplink,
         ~ pc1.eth0,
         ~ pc2.eth0,
         ~ fileserver.eth0);
    }

    // The wireless cell: the AP serves, the stations are peers.
    @office_wifi: nw.wireless_cell {
        (+ ap1.radio,
         ~ laptop.wlan0);
    }

    // The DMZ: only the router and the web server.
    @dmz_segment: nw.segment {
        (+ gw.dmz_port,
         ~ webserver.eth0);
    }

    // Point-to-point runs. Two ends, `+` upstream and `-` downstream.
    @ap_backhaul: nw.p2p_link {
        (+ sw1.p3,
         - ap1.wired);
    }
    @wifi_uplink: nw.p2p_link {
        (+ gw.wlan_uplink,
         - ap1.wired);
    }
    @firewall_inside: nw.p2p_link {
        (+ fw.inside,
         - gw.wan);
    }

    // ── Routing ───────────────────────────────────────────────────────────
    // `(+ next_hop, - destination_subnet)`.
    @default_route: nw.route {
        (+ fw.inside,
         - office_net);
    }
    @dmz_route: nw.route {
        (+ gw.dmz_port,
         - dmz_net);
    }

    // ── Policy ────────────────────────────────────────────────────────────
    // `(+ source, - destination, ~ service)`. Each rule is one hyperedge, so
    // a query for `policy_definition` returns the whole rule set with its
    // sources, destinations and services already bound.
    @web_from_anywhere: nw.allow {
        (+ office_net,
         - webserver.eth0,
         ~ svc.https);
    }
    @admin_ssh: nw.allow {
        (+ pc1.eth0,
         - fileserver.eth0,
         ~ svc.ssh);
    }
    @wifi_may_browse: nw.allow {
        (+ wifi_net,
         - webserver.eth0,
         ~ svc.https);
    }
    // Guests on the wireless net have no business on the file server.
    @wifi_denied_fileserver: nw.deny {
        (+ wifi_net,
         - fileserver.eth0,
         ~ svc.ssh);
    }
}
