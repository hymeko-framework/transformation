traceability_simulation_description {
    @"meta_simulation_case.hymeko";
    @"traceability_verification.hymeko";
    @"../robotics/sim/dual_fanuc/fanuc_lrmate200id.hymeko";
    using simulation_types as sim;
    using robot as arm;
    using verification_cell as trace;
}

// Imported FANUC links/joints are reused. This cup is the declared ideal-vacuum tool.
cup_color [0.12,0.3,0.7,1];
vacuum_cup: meta_kinematics.kinematics.elements.link {
    mass 0.05;
    origin [0,0,0.015];
    link_geometry: meta_kinematics.kinematics.geometry.cylinder { dimension [0.025,0.03]; }
    color -> cup_color;
}
@cup_mount: meta_kinematics.kinematics.fixed_joint {
    (+ arm.tool_flange [[0,0,0.02],[0,0,0]], - vacuum_cup);
}

controls: sim.control_profile {
    timestep_s 0.0005; sample_hz 100; episode_s 10;
    control_period_s 0.0005;
    actuator_kp 800; actuator_kd 50; actuator_limit 60;
    joint_damping 0.8; joint_armature 0.02;
    exercise_rad 0; exercise_hz 0;
    reset_noise_rad 0; encoder_noise_rad 0; gyro_noise_rad_s 0; accel_noise_m_s2 0;
    floor_z 0; floor_friction 0.8; imu_id 0; seed 42;
    joint_encoders 1; imu 1; contact_forces 1;
}
scene: sim.scene_profile {
    payload_mass_kg 0.03;
    payload_half_size [0.02,0.02,0.02];
    table_half_size [0.25,0.3,0.025];
    payload_friction 0.8;
    // TCP is at the object's centre. The cup body begins 20 mm below the flange.
    tcp_offset [0,0,0.07]; grasp_offset [0,0,0.05];
    grasp_distance_m 0.01; retained_distance_m 0.01; required_lift_m 0.04;
    stop_at_s 2; stop_speed_m_s 0.005; stop_joint_speed_rad_s 0.05; stop_dwell_s 0.05;
    station_window_s 0.1;
}
// Values follow the referenced joint order; revolute coordinates are radians.
home: sim.joint_target { q [-0.2,0.7,0.8,0,1.641592653589793,0]; }
pick: sim.joint_target { q [-0.2,0.9,0.8,0,1.441592653589793,0]; }
lift: sim.joint_target { q [-0.2,0.7,0.8,0,1.641592653589793,0]; }
place: sim.joint_target { q [0.2,0.9,0.8,0,1.441592653589793,0]; }
retreat: sim.joint_target { q [0.2,0.7,0.8,0,1.641592653589793,0]; }

experiment: sim.case_definition {
    robot_model -> arm; trace_scope -> trace;
    tool -> arm.tool_flange; gripper -> vacuum_cup;
    control -> controls; environment -> scene;
    joints [arm.j1,arm.j2,arm.j3,arm.j4,arm.j5,arm.j6];
    initial -> home; targets [pick,lift,place,retreat];
    // MissionMotion's existing policy: 0.75 rad/s, minimum 0.35 s ramp,
    // 0.05 s rest and 0.3 s dwell per target. No new interpolation implementation.
}

@position_evidence: sim.observes {
    (+ trace.T_accuracy, - experiment);
    metric "station_error_m"; comparison "max"; bound 0.0005;
}
@cycle_evidence: sim.observes {
    (+ trace.T_cycle, - experiment);
    metric "cycle_time_s"; comparison "max"; bound 4;
}
@repeat_evidence: sim.observes {
    (+ trace.T_repeat, - experiment);
    metric "repeatability_m"; comparison "max"; bound 0.0001;
}
@stop_evidence: sim.observes {
    (+ trace.T_stop, - experiment);
    metric "stop_latency_s"; comparison "max"; bound 0.2;
}
@grip_evidence: sim.observes {
    (+ trace.T_grip, - experiment);
    metric "ideal_grip_retained"; comparison "min"; bound 1;
}
@diagnostic_evidence: sim.observes {
    (+ trace.T_diagnostics, - experiment);
    metric "diagnostics_complete"; comparison "min"; bound 1;
}
