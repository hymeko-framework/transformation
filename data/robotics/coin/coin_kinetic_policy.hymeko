// coin_kinetic_policy.hymeko — the KINETIC transport policy INTERFACE, declared in HyMeKo.
//
// This is the observation/action CONTRACT of the R9 R3-C kinetic-transport residual policy — the schema the frozen
// checkpoints were sized against — moved OUT of the hand-authored Python literal (kinetic_contract.py::FEATURE_NAMES,
// kinetic_clone.py::ACT_DIM) and INTO a HyMeKo model, read through the existing generic projection primitives
// (hymeko_rl/env/_profile.py: read_bundle / read_scene_fields). Reuses two existing forms:
//   - the observation_space bundle (arm_reach_observation.hymeko form): the 41 ordered kinetic feature channels;
//   - the numeric normalized-action scalars (toy_reach.hymeko form): action_dim + action_scale.
//
// SEMANTICS (proven, do not conflate): @action declares the NORMALIZED POLICY-OUTPUT space [-1,+1]^4 (the Tanh actor
// output). The deployed Delta-tau / slew / torque-governor is a SEPARATE frozen control contract and is NOT declared
// here. The 41-channel order is the migration assertion target: projected names == FEATURE_NAMES (hard fail otherwise);
// obs_dim = len(projected names) (= 41), action_dim asserted == the residual checkpoint output dim (= 4).

coin_kinetic_policy_description {
    @"../meta_observation.hymeko";        // observation.feature / observation.observation_space vocabulary
    @"../meta_scenario.hymeko";           // scenario.scene — the numeric action-contract scalar fields (toy_reach form)
    using observation as obs;
    using scenario     as scn;
}

coin_kinetic_policy: obs, scn
{
    // === the 41 ordered kinetic observation channels (== FEATURE_NAMES, frozen order) ===
    // base (29): coin-frame kinematics + bilateral contact + per-tip relative state + joint state + prev action + corridor
    @dtz:              obs.feature { dim 1; }
    @v_par:            obs.feature { dim 1; }
    @v_lat:            obs.feature { dim 1; }
    @spin:             obs.feature { dim 1; }
    @fn_l:             obs.feature { dim 1; }
    @fn_r:             obs.feature { dim 1; }
    @relpos_par_l:     obs.feature { dim 1; }
    @relpos_lat_l:     obs.feature { dim 1; }
    @relvel_par_l:     obs.feature { dim 1; }
    @relvel_lat_l:     obs.feature { dim 1; }
    @slip_l:           obs.feature { dim 1; }
    @relpos_par_r:     obs.feature { dim 1; }
    @relpos_lat_r:     obs.feature { dim 1; }
    @relvel_par_r:     obs.feature { dim 1; }
    @relvel_lat_r:     obs.feature { dim 1; }
    @slip_r:           obs.feature { dim 1; }
    @q0:               obs.feature { dim 1; }
    @q1:               obs.feature { dim 1; }
    @q2:               obs.feature { dim 1; }
    @q3:               obs.feature { dim 1; }
    @qd0:              obs.feature { dim 1; }
    @qd1:              obs.feature { dim 1; }
    @qd2:              obs.feature { dim 1; }
    @qd3:              obs.feature { dim 1; }
    @prev0:            obs.feature { dim 1; }
    @prev1:            obs.feature { dim 1; }
    @prev2:            obs.feature { dim 1; }
    @prev3:            obs.feature { dim 1; }
    @dist_to_corridor: obs.feature { dim 1; }
    // short causal history (12 = 3 steps x {dtz, v_par, fn_l, fn_r})
    @hist0_dtz:        obs.feature { dim 1; }
    @hist0_v_par:      obs.feature { dim 1; }
    @hist0_fn_l:       obs.feature { dim 1; }
    @hist0_fn_r:       obs.feature { dim 1; }
    @hist1_dtz:        obs.feature { dim 1; }
    @hist1_v_par:      obs.feature { dim 1; }
    @hist1_fn_l:       obs.feature { dim 1; }
    @hist1_fn_r:       obs.feature { dim 1; }
    @hist2_dtz:        obs.feature { dim 1; }
    @hist2_v_par:      obs.feature { dim 1; }
    @hist2_fn_l:       obs.feature { dim 1; }
    @hist2_fn_r:       obs.feature { dim 1; }

    // === the observation space = the ordered bundle of channels (arc order IS the frozen feature order) ===
    @kinetic_observation: obs.observation_space {
        (+ dtz, + v_par, + v_lat, + spin, + fn_l, + fn_r,
         + relpos_par_l, + relpos_lat_l, + relvel_par_l, + relvel_lat_l, + slip_l,
         + relpos_par_r, + relpos_lat_r, + relvel_par_r, + relvel_lat_r, + slip_r,
         + q0, + q1, + q2, + q3, + qd0, + qd1, + qd2, + qd3,
         + prev0, + prev1, + prev2, + prev3, + dist_to_corridor,
         + hist0_dtz, + hist0_v_par, + hist0_fn_l, + hist0_fn_r,
         + hist1_dtz, + hist1_v_par, + hist1_fn_l, + hist1_fn_r,
         + hist2_dtz, + hist2_v_par, + hist2_fn_l, + hist2_fn_r);
    }

    // === the NORMALIZED policy-output action contract ([-1,+1]^4 Tanh space; NOT Delta-tau, NOT a force scale) ===
    // The scalar-field container reuses toy_reach's SYNTAX (parse_fields is kind-agnostic), but NOT its semantics:
    // toy_reach's `action_scale` is a physical |f| bound, whereas the bound below is the dimensionless Tanh
    // policy-output range. action_dim = normalized residual channel count (= actuated-joint count = 4), asserted
    // == the residual checkpoint output dim; action_low/high are the fixed Tanh policy-output bounds.
    @action: scn.scene {
        action_dim  4;       // normalized residual channels (== residual checkpoint output dim)
        action_low  -1.0;    // Tanh policy-output lower bound (normalized space, NOT a force limit)
        action_high 1.0;     // Tanh policy-output upper bound
    }
}
