// galambos_env.hymeko — the Galambos planar-grasp ENVIRONMENT, declaratively.
//
// The scene/task geometry that used to be hardcoded in planar_grasp_env.py: a small target zone
// re-placed each episode within both-arm reach, an object spawn region over the reachable table
// (the object may start OUTSIDE the between-arms band), the workspace bounds, and the success
// criterion. Read by PlanarGraspEnv.from_hymeko(robot=, env=, task=). Validates via `hymeko inspect`.

galambos_env_description {
    @"../meta_env.hymeko";
    using env.params as p;
    using env        as e;
}

galambos_env: p, e
{
    // Small zone (half 0.04), randomized each episode in a box inside both-arm reach.
    @zone:   p.target_zone { half 0.04; rx_lo -0.05; rx_hi 0.05; ry_lo 0.10; ry_hi 0.18; randomize 1.0; }

    // Coin spawn: the full reachable table (can be outside the |x|<=0.11 arm band), >= clearance from the zone.
    @spawn:  p.coin_spawn  { rx_lo -0.20; rx_hi 0.20; ry_lo 0.05; ry_hi 0.23; clearance 0.03; }

    // Workspace: coin knocked past these = death.
    @bounds: p.workspace   { x_bound 0.40; y_min -0.08; y_max 0.45; }

    // Success: 5 consecutive in-zone steps.
    @succ:   p.success     { steps 5.0; }

    // The manipulated OBJECT — full physical identity in HyMeKo (R11.7A unification), not split into
    // Python kwargs. OBJ_O0 = the reference coin: a round disk, radius 0.02 m, 0.02 m half-thickness,
    // slide-damping 2.5 (planar table drag), spin-damping 0.8; MuJoCo-default density; no frictionloss.
    // Object variants (OBJ_O1..O4) are other `p.disk` declarations (shape/radius_y/density/frictionloss),
    // NOT pipeline edits. Every field here equals the builder's current coin defaults, so O0 is unchanged.
    @dsk:    p.disk        { shape "cylinder"; family "coin"; radius 0.02; half 0.02; damping 2.5; spin_damping 0.8; frictionloss 0.0; }

    // H1-safe handoff admissibility (compositional capture→H1 contract). The capture handed to H1 must have both
    // primary fingertip contacts with normal force >= the H1 fn_min_safe, else H1's APPROACH takes an immediate
    // contact-risk SAFETY exit (never reaches KINETIC). Selection-only: the local F0 capture certificate is
    // unchanged; the value is bound at the runtime seam from the single fn_min_safe owner (ApproachParams).
    // require_robust is DORMANT (0.0): the FR (robust) contract is implemented + verified but not activated — the V1
    // measured seed-5 to reach KINETIC under FR yet stall K6 DOWNSTREAM (KINETIC releases the coin ~26mm; it coasts to
    // 23.48mm at the 60-step horizon; the gripped completion cannot catch a released coin). Activating require_robust
    // 1.0 needs the downstream (KINETIC release/coast or horizon) addressed AND a golden re-baseline (2/3 golden bank
    // captures are F1-not-FR). See reports/2026-08-16-hymeko-robust-handoff-admissibility.md.
    @handoff: p.handoff    { require_bilateral 1.0; require_min_force 1.0; require_robust 0.0; }

    @env_spec: e.env_spec {
        (+ zone, + spawn, + bounds, + succ, + dsk, + handoff);
    }
}
