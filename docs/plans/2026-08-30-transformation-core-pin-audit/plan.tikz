\begin{tikzpicture}[
  >=Stealth, node distance=9mm and 16mm,
  box/.style={draw, rounded corners, align=center, font=\small, minimum height=8mm},
  core/.style={box, fill=blue!8},
  cons/.style={box, fill=green!8},
  lock/.style={box, fill=orange!10}]
  \node[core] (core) {hymeko\_core\\texttt{71c1f997} $\rightarrow$ \texttt{15223bc}\(accessor API)};
  \node[core, below=of core] (parser) {parser\\texttt{e28a2051} (held)};
  \node[lock, right=of core] (lock) {Cargo.lock\one-line rev bump};
  \node[cons, right=of lock] (emit) {hymeko\_emitter\bridge · emit\_*};
  \node[cons, below=of emit] (query) {hymeko\_query\engine · rewrite · entropy};
  \node[cons, below=of query] (fmt) {hymeko\_formats\snapshot · codegen};
  \draw[->] (core) -- (lock);
  \draw[->] (parser) -- (lock);
  \draw[->] (lock) -- (emit);
  \draw[->] (lock) -- (query);
  \draw[->] (lock) -- (fmt);
  \begin{scope}[on background layer]
    \node[draw, dashed, fit=(emit)(query)(fmt), inner sep=4mm, label=above:{consumers: recompile only, source byte-identical}] {};
