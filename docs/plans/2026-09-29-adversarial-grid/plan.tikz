\begin{tikzpicture}[node distance=7mm, every node/.style={draw,rounded corners,align=center,font=\small}, >=Stealth]
\node (seed) {Seed + bounded layout proposal};
\node[below=of seed] (core) {Core compilation + canonical IR};
\node[below=of core] (graph) {Existing Graph BFS / A* + work counters};
\node[below=of graph] (select) {Feasibility + best-of-budget selection};
\node[below=of select] (emit) {Emitter round trip + Formats SDF template};
\node[below=of emit] (remote) {Amaterasu: campaign + finite Gazebo run};
\node[below=of remote] (results) {JSON + plots + path witness + GIF + report};
\draw[->] (seed)--(core);
\draw[->] (core)--(graph);
\draw[->] (graph)--(select);
\draw[->] (select)--(emit);
\draw[->] (emit)--(remote);
\draw[->] (remote)--(results);
\end{tikzpicture}
