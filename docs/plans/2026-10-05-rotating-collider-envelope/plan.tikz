\begin{tikzpicture}[every node/.style={draw,align=center}]
\node (ir) at (0,0) {Core/Query\\Cyberdisc actor};
\node (fk) at (5,0) {Geometry\\FK + colliders};
\node (admit) at (10,0) {Formats\\conservative admission};
\draw[->] (ir) -- (fk); \draw[->] (fk) -- (admit);
\end{tikzpicture}

\begin{tikzpicture}[every node/.style={draw,align=center}]
\node (relation) at (0,0) {Geometry joint\\parent/child IDs};
\node (profile) at (5,0) {Direct chassis mount\\fixed or rotational};
\node (bound) at (10,0) {Existing envelope\\precondition holds};
\draw[->] (relation) -- (profile); \draw[->] (profile) -- (bound);
\end{tikzpicture}
