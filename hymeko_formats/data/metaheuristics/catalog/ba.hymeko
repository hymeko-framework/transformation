// Descriptive macro projection; not an executable optimizer.
metaheuristic_structure {}
vocabulary { method_kind {} state_kind {} @operator_kind {} @read_role {} @write_role {} }
method: vocabulary.method_kind {
    label "Bat Algorithm";
    source "https://arxiv.org/abs/1004.4170v1";
    notes "Source has unresolved position indexing and an underspecified random-flight step; this descriptor is deliberately non-executable.";
    schedule "unspecified";
    states {
        slot_population: vocabulary.state_kind { space "population"; }
        slot_scores: vocabulary.state_kind { space "scores"; }
        slot_best: vocabulary.state_kind { space "point"; }
        slot_bounds: vocabulary.state_kind { space "bounds"; }
        slot_parameters: vocabulary.state_kind { space "scalar"; }
        slot_random: vocabulary.state_kind { space "random"; }
        slot_objective: vocabulary.state_kind { space "function"; }
        slot_count: vocabulary.state_kind { space "counter"; }
        slot_clock: vocabulary.state_kind { space "counter"; }
        slot_velocity: vocabulary.state_kind { space "vector"; }
        slot_frequency: vocabulary.state_kind { space "scalar"; }
        slot_pulse: vocabulary.state_kind { space "scalar"; }
        slot_loudness: vocabulary.state_kind { space "scalar"; }
        slot_trial: vocabulary.state_kind { space "point"; }
        slot_trial_score: vocabulary.state_kind { space "scalar"; }
    }
    operators {
        @op_initialize: vocabulary.operator_kind {
            stage 0; category "initialize"; family "uniform_initialization"; guard "always";
            rule "Initialize candidate population; auxiliary initial values belong to the declared source profile.";
            @reads: vocabulary.read_role { (~ method.states.slot_bounds, ~ method.states.slot_random, ~ method.states.slot_parameters); }
            @writes: vocabulary.write_role { (~ method.states.slot_population, ~ method.states.slot_velocity, ~ method.states.slot_pulse, ~ method.states.slot_loudness); }
        }
        @op_evaluate: vocabulary.operator_kind {
            stage 1; category "evaluate"; family "objective_evaluation"; guard "always";
            rule "Evaluate each supplied candidate; every objective invocation consumes one unit.";
            @reads: vocabulary.read_role { (~ method.states.slot_population, ~ method.states.slot_objective, ~ method.states.slot_count); }
            @writes: vocabulary.write_role { (~ method.states.slot_scores, ~ method.states.slot_count); }
        }
        @op_archive: vocabulary.operator_kind {
            stage 2; category "archive"; family "minimum_archive"; guard "always";
            rule "Retain the best observed population member under minimization.";
            @reads: vocabulary.read_role { (~ method.states.slot_population, ~ method.states.slot_scores, ~ method.states.slot_best); }
            @writes: vocabulary.write_role { (~ method.states.slot_best); }
        }
        @op_frequency: vocabulary.operator_kind {
            stage 3; category "adapt"; family "coefficient_schedule"; guard "always";
            rule "frequency = f_min + (f_max-f_min)*u.";
            @reads: vocabulary.read_role { (~ method.states.slot_parameters, ~ method.states.slot_random); }
            @writes: vocabulary.write_role { (~ method.states.slot_frequency); }
        }
        @op_velocity: vocabulary.operator_kind {
            stage 4; category "vary"; family "velocity_attraction"; guard "always";
            rule "v_next = v + (x-best)*frequency; source indexing needs disambiguation.";
            @reads: vocabulary.read_role { (~ method.states.slot_population, ~ method.states.slot_velocity, ~ method.states.slot_best, ~ method.states.slot_frequency); }
            @writes: vocabulary.write_role { (~ method.states.slot_velocity); }
        }
        @op_position: vocabulary.operator_kind {
            stage 5; category "vary"; family "position_integration"; guard "always";
            rule "Propose a position using the updated velocity.";
            @reads: vocabulary.read_role { (~ method.states.slot_population, ~ method.states.slot_velocity); }
            @writes: vocabulary.write_role { (~ method.states.slot_trial); }
        }
        @op_local: vocabulary.operator_kind {
            stage 6; category "vary"; family "uniform_perturbation"; guard "probability";
            rule "Perturb a selected elite by epsilon times average loudness.";
            @reads: vocabulary.read_role { (~ method.states.slot_best, ~ method.states.slot_loudness, ~ method.states.slot_pulse, ~ method.states.slot_random); }
            @writes: vocabulary.write_role { (~ method.states.slot_trial); }
        }
        @op_trial_evaluation: vocabulary.operator_kind {
            stage 7; category "evaluate"; family "objective_evaluation"; guard "always";
            rule "Evaluate each supplied candidate; every objective invocation consumes one unit.";
            @reads: vocabulary.read_role { (~ method.states.slot_trial, ~ method.states.slot_objective, ~ method.states.slot_count); }
            @writes: vocabulary.write_role { (~ method.states.slot_trial_score, ~ method.states.slot_count); }
        }
        @op_accept: vocabulary.operator_kind {
            stage 8; category "accept"; family "best_gate"; guard "improvement";
            rule "Accept under the loudness gate and the source best-comparison condition.";
            @reads: vocabulary.read_role { (~ method.states.slot_trial, ~ method.states.slot_trial_score, ~ method.states.slot_best, ~ method.states.slot_loudness, ~ method.states.slot_random); }
            @writes: vocabulary.write_role { (~ method.states.slot_population, ~ method.states.slot_scores); }
        }
        @op_adapt: vocabulary.operator_kind {
            stage 9; category "adapt"; family "amplitude_schedule"; guard "improvement";
            rule "A_next=alpha*A; pulse_next=pulse0*(1-exp(-gamma*t)).";
            @reads: vocabulary.read_role { (~ method.states.slot_loudness, ~ method.states.slot_pulse, ~ method.states.slot_clock, ~ method.states.slot_parameters); }
            @writes: vocabulary.write_role { (~ method.states.slot_loudness, ~ method.states.slot_pulse); }
        }
    }
}
