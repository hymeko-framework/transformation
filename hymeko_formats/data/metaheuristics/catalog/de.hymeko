// Descriptive macro projection; not an executable optimizer.
metaheuristic_structure {}
vocabulary { method_kind {} state_kind {} @operator_kind {} @read_role {} @write_role {} }
method: vocabulary.method_kind {
    label "DE/rand/1/bin reference";
    source "../de_rand_1_bin.hymeko";
    notes "Macro view of the existing clamped deferred DE profile; the full frozen contract remains authoritative.";
    schedule "deferred";
    states {
        slot_population: vocabulary.state_kind { space "population"; }
        slot_scores: vocabulary.state_kind { space "scores"; }
        slot_best: vocabulary.state_kind { space "point"; }
        slot_bounds: vocabulary.state_kind { space "bounds"; }
        slot_parameters: vocabulary.state_kind { space "scalar"; }
        slot_random: vocabulary.state_kind { space "random"; }
        slot_objective: vocabulary.state_kind { space "function"; }
        slot_count: vocabulary.state_kind { space "counter"; }
        slot_clock: vocabulary.state_kind { space "counter"; }
        slot_donors: vocabulary.state_kind { space "indices"; }
        slot_mutant: vocabulary.state_kind { space "point"; }
        slot_trial: vocabulary.state_kind { space "point"; }
        slot_trial_score: vocabulary.state_kind { space "scalar"; }
    }
    operators {
        @op_initialize: vocabulary.operator_kind {
            stage 0; category "initialize"; family "uniform_initialization"; guard "always";
            rule "Initialize candidate population; auxiliary initial values belong to the declared source profile.";
            @reads: vocabulary.read_role { (~ method.states.slot_bounds, ~ method.states.slot_random, ~ method.states.slot_parameters); }
            @writes: vocabulary.write_role { (~ method.states.slot_population); }
        }
        @op_evaluate: vocabulary.operator_kind {
            stage 1; category "evaluate"; family "objective_evaluation"; guard "always";
            rule "Evaluate each supplied candidate; every objective invocation consumes one unit.";
            @reads: vocabulary.read_role { (~ method.states.slot_population, ~ method.states.slot_objective, ~ method.states.slot_count); }
            @writes: vocabulary.write_role { (~ method.states.slot_scores, ~ method.states.slot_count); }
        }
        @op_donors: vocabulary.operator_kind {
            stage 2; category "select"; family "random_peer_selection"; guard "always";
            rule "Three distinct donors exclude the current target.";
            @reads: vocabulary.read_role { (~ method.states.slot_population, ~ method.states.slot_random); }
            @writes: vocabulary.write_role { (~ method.states.slot_donors); }
        }
        @op_mutate: vocabulary.operator_kind {
            stage 3; category "vary"; family "difference_mutation"; guard "always";
            rule "v = x_a + F*(x_b-x_c).";
            @reads: vocabulary.read_role { (~ method.states.slot_population, ~ method.states.slot_donors, ~ method.states.slot_parameters); }
            @writes: vocabulary.write_role { (~ method.states.slot_mutant); }
        }
        @op_cross: vocabulary.operator_kind {
            stage 4; category "vary"; family "coordinate_mix"; guard "always";
            rule "Binomial coordinate mask with one forced coordinate.";
            @reads: vocabulary.read_role { (~ method.states.slot_population, ~ method.states.slot_mutant, ~ method.states.slot_random, ~ method.states.slot_parameters); }
            @writes: vocabulary.write_role { (~ method.states.slot_trial); }
        }
        @op_repair: vocabulary.operator_kind {
            stage 5; category "vary"; family "box_projection"; guard "always";
            rule "Boundary handling is recorded as a domain projection; exact repair policy must be frozen before execution.";
            @reads: vocabulary.read_role { (~ method.states.slot_trial, ~ method.states.slot_bounds); }
            @writes: vocabulary.write_role { (~ method.states.slot_trial); }
        }
        @op_trial_evaluation: vocabulary.operator_kind {
            stage 6; category "evaluate"; family "objective_evaluation"; guard "always";
            rule "Evaluate each supplied candidate; every objective invocation consumes one unit.";
            @reads: vocabulary.read_role { (~ method.states.slot_trial, ~ method.states.slot_objective, ~ method.states.slot_count); }
            @writes: vocabulary.write_role { (~ method.states.slot_trial_score, ~ method.states.slot_count); }
        }
        @op_survive: vocabulary.operator_kind {
            stage 7; category "accept"; family "pairwise_greedy"; guard "always";
            rule "Replace target on trial <= parent; defer generation publication.";
            @reads: vocabulary.read_role { (~ method.states.slot_population, ~ method.states.slot_scores, ~ method.states.slot_trial, ~ method.states.slot_trial_score); }
            @writes: vocabulary.write_role { (~ method.states.slot_population, ~ method.states.slot_scores); }
        }
        @op_archive: vocabulary.operator_kind {
            stage 8; category "archive"; family "minimum_archive"; guard "always";
            rule "Retain the best observed population member under minimization.";
            @reads: vocabulary.read_role { (~ method.states.slot_population, ~ method.states.slot_scores, ~ method.states.slot_best); }
            @writes: vocabulary.write_role { (~ method.states.slot_best); }
        }
    }
}
