// Descriptive macro projection; not an executable optimizer.
metaheuristic_structure {}
vocabulary { method_kind {} state_kind {} @operator_kind {} @read_role {} @write_role {} }
method: vocabulary.method_kind {
    label "Whale Optimization Algorithm";
    source "https://doi.org/10.1016/j.advengsoft.2016.01.008";
    notes "Macro view of shrinking/random-reference displacement and spiral branches; source-order and boundary details are not frozen.";
    schedule "unspecified";
    states {
        slot_population: vocabulary.state_kind { space "population"; }
        slot_scores: vocabulary.state_kind { space "scores"; }
        slot_best: vocabulary.state_kind { space "point"; }
        slot_bounds: vocabulary.state_kind { space "bounds"; }
        slot_parameters: vocabulary.state_kind { space "scalar"; }
        slot_random: vocabulary.state_kind { space "random"; }
        slot_objective: vocabulary.state_kind { space "function"; }
        slot_count: vocabulary.state_kind { space "counter"; }
        slot_clock: vocabulary.state_kind { space "counter"; }
        slot_branch: vocabulary.state_kind { space "mask"; }
        slot_coefficient: vocabulary.state_kind { space "vector"; }
        slot_peer: vocabulary.state_kind { space "point"; }
        slot_trial: vocabulary.state_kind { space "point"; }
    }
    operators {
        @op_initialize: vocabulary.operator_kind {
            stage 0; category "initialize"; family "uniform_initialization"; guard "always";
            rule "Initialize candidate population; auxiliary initial values belong to the declared source profile.";
            @reads: vocabulary.read_role { (~ method.states.slot_bounds, ~ method.states.slot_random, ~ method.states.slot_parameters); }
            @writes: vocabulary.write_role { (~ method.states.slot_population); }
        }
        @op_evaluate: vocabulary.operator_kind {
            stage 1; category "evaluate"; family "objective_evaluation"; guard "always";
            rule "Evaluate each supplied candidate; every objective invocation consumes one unit.";
            @reads: vocabulary.read_role { (~ method.states.slot_population, ~ method.states.slot_objective, ~ method.states.slot_count); }
            @writes: vocabulary.write_role { (~ method.states.slot_scores, ~ method.states.slot_count); }
        }
        @op_archive: vocabulary.operator_kind {
            stage 2; category "archive"; family "minimum_archive"; guard "always";
            rule "Retain the best observed population member under minimization.";
            @reads: vocabulary.read_role { (~ method.states.slot_population, ~ method.states.slot_scores, ~ method.states.slot_best); }
            @writes: vocabulary.write_role { (~ method.states.slot_best); }
        }
        @op_coefficients: vocabulary.operator_kind {
            stage 3; category "adapt"; family "coefficient_schedule"; guard "always";
            rule "A=2*a*r-a; a decreases from two to zero.";
            @reads: vocabulary.read_role { (~ method.states.slot_clock, ~ method.states.slot_parameters, ~ method.states.slot_random); }
            @writes: vocabulary.write_role { (~ method.states.slot_coefficient); }
        }
        @op_branch: vocabulary.operator_kind {
            stage 4; category "select"; family "branch_choice"; guard "always";
            rule "Select distance or spiral branch; coefficient magnitude selects best versus random reference.";
            @reads: vocabulary.read_role { (~ method.states.slot_coefficient, ~ method.states.slot_random); }
            @writes: vocabulary.write_role { (~ method.states.slot_branch); }
        }
        @op_peer: vocabulary.operator_kind {
            stage 5; category "select"; family "random_peer_selection"; guard "always";
            rule "Sample a population reference for exploration.";
            @reads: vocabulary.read_role { (~ method.states.slot_population, ~ method.states.slot_random); }
            @writes: vocabulary.write_role { (~ method.states.slot_peer); }
        }
        @op_distance: vocabulary.operator_kind {
            stage 6; category "vary"; family "distance_attraction"; guard "branch";
            rule "x_next = reference - A*abs(C*reference-x).";
            @reads: vocabulary.read_role { (~ method.states.slot_population, ~ method.states.slot_best, ~ method.states.slot_peer, ~ method.states.slot_coefficient, ~ method.states.slot_branch, ~ method.states.slot_random); }
            @writes: vocabulary.write_role { (~ method.states.slot_trial); }
        }
        @op_spiral: vocabulary.operator_kind {
            stage 7; category "vary"; family "spiral_perturbation"; guard "branch";
            rule "x_next = abs(best-x)*exp(b*l)*cos(2*pi*l)+best.";
            @reads: vocabulary.read_role { (~ method.states.slot_population, ~ method.states.slot_best, ~ method.states.slot_parameters, ~ method.states.slot_random, ~ method.states.slot_branch); }
            @writes: vocabulary.write_role { (~ method.states.slot_trial); }
        }
        @op_publish: vocabulary.operator_kind {
            stage 8; category "accept"; family "position_integration"; guard "always";
            rule "Publish the selected branch proposal.";
            @reads: vocabulary.read_role { (~ method.states.slot_trial); }
            @writes: vocabulary.write_role { (~ method.states.slot_population); }
        }
    }
}
