// Exact bounded research profile; macro rules are checked, not interpreted.
hho_contract {}
vocabulary { profile_kind {} state_kind {} @operator_kind {} @read_role {} @write_role {} }
profile: vocabulary.profile_kind {
    key "hho-sequential-clamped-budget-v1";
    optimization "minimize";
    arithmetic "python_binary64";
    dimensions "1<=D<=64,4<=N<=8,N<=B<=80";
    parameters "finite_bounds_lo<hi;clock_in_evaluations_or_iterations;beta=1.5;shared_Config_validation";
    source "HHO.m@e5d854f64e0af5207e33c25dc196629b00d00d25;source_derived_not_verbatim";
    update "sequential_in_place;leader_changes_only_on_population_scan";
    boundary "require_finite;clamp_each_objective_input;store_repaired_accepted_trial;pending_raw_moves_repaired_at_scan";
    clock "factor_frozen_after_scan;iterations:2*(1-t/ceil(B/N));evaluations:2*(1-(count-N)/(B-N));no_update_at_B=N";
    branches "absE>=1_explore;q<0.5_peer;otherwise_mean;r>=0.5_no_dive;absE<0.5_hard;otherwise_soft";
    acceptance "unconditional_pending_moves;rapid_dive_strict_trial_lt_fresh_parent";
    randomness "python_Random;ordered_scalar_uniforms;conditional_Levy_multipliers_then_u_normals_then_v_normals";
    levy "beta=1.5;Mantegna_sigma;no_extra_scale;zero_divisor_or_nonfinite_is_failure";
    budget "initialization_and_repeated_parent_calls_included;stop_before_B_plus_one;no_Levy_draw_after_exhaustion";
    archive "host_ledger_min_all_evaluated;ties_keep_previous_archive_vector";
    return "host_best_ever;last_scored_slot_snapshots_separate_from_pending_positions";
    partial "stop_mid_scan_or_comparison;do_not_fabricate_unobserved_parent_score";
    event_coverage "objective_events_and_proposal_snapshots;not_a_complete_transition_observer";
}
states {
    archive_best: vocabulary.state_kind { key "archive_best"; }
    bounds: vocabulary.state_kind { key "bounds"; }
    branch: vocabulary.state_kind { key "branch"; }
    budget_limit: vocabulary.state_kind { key "budget_limit"; }
    clock_kind: vocabulary.state_kind { key "clock_kind"; }
    decision_source: vocabulary.state_kind { key "decision_source"; }
    energy_factor: vocabulary.state_kind { key "energy_factor"; }
    evaluated_candidate: vocabulary.state_kind { key "evaluated_candidate"; }
    evaluated_score: vocabulary.state_kind { key "evaluated_score"; }
    evaluation_count: vocabulary.state_kind { key "evaluation_count"; }
    initial_population: vocabulary.state_kind { key "initial_population"; }
    iteration: vocabulary.state_kind { key "iteration"; }
    last_scored_population: vocabulary.state_kind { key "last_scored_population"; }
    last_scored_scores: vocabulary.state_kind { key "last_scored_scores"; }
    leader: vocabulary.state_kind { key "leader"; }
    leader_score: vocabulary.state_kind { key "leader_score"; }
    objective: vocabulary.state_kind { key "objective"; }
    parent_score: vocabulary.state_kind { key "parent_score"; }
    population_size: vocabulary.state_kind { key "population_size"; }
    positions: vocabulary.state_kind { key "positions"; }
    proposal: vocabulary.state_kind { key "proposal"; }
    random_record: vocabulary.state_kind { key "random_record"; }
    run_status: vocabulary.state_kind { key "run_status"; }
    target_index: vocabulary.state_kind { key "target_index"; }
    trial_point: vocabulary.state_kind { key "trial_point"; }
    trial_score: vocabulary.state_kind { key "trial_score"; }
}
operators {
    @initialize: vocabulary.operator_kind {
        key "hho.initialize";
        rule "admit_fresh_matching_ledger;copy_provided_bounded_population;initialize_scan_leader_and_last_scored_slots";
        @reads: vocabulary.read_role { (~ states.initial_population, ~ states.bounds); }
        @writes: vocabulary.write_role { (~ states.positions, ~ states.last_scored_population, ~ states.last_scored_scores, ~ states.leader, ~ states.leader_score, ~ states.iteration, ~ states.target_index); }
    }
    @evaluate_population: vocabulary.operator_kind {
        key "hho.evaluate_population";
        rule "require_count<B;clamp_finite_current_slot;charge_objective;store_scored_slot";
        @reads: vocabulary.read_role { (~ states.positions, ~ states.target_index, ~ states.bounds, ~ states.objective, ~ states.evaluation_count, ~ states.budget_limit); }
        @writes: vocabulary.write_role { (~ states.positions, ~ states.last_scored_population, ~ states.last_scored_scores, ~ states.evaluated_candidate, ~ states.evaluated_score, ~ states.evaluation_count); }
    }
    @leader: vocabulary.operator_kind {
        key "hho.leader";
        rule "population_scan_only;replace_leader_iff_scanned_score_strictly_lower";
        @reads: vocabulary.read_role { (~ states.evaluated_candidate, ~ states.evaluated_score, ~ states.leader, ~ states.leader_score); }
        @writes: vocabulary.write_role { (~ states.leader, ~ states.leader_score); }
    }
    @clock: vocabulary.operator_kind {
        key "hho.clock";
        rule "after_scan_freeze_energy_factor_from_selected_clock;B=N_stops_before_update";
        @reads: vocabulary.read_role { (~ states.clock_kind, ~ states.iteration, ~ states.evaluation_count, ~ states.population_size, ~ states.budget_limit); }
        @writes: vocabulary.write_role { (~ states.energy_factor); }
    }
    @propose: vocabulary.operator_kind {
        key "hho.propose";
        rule "sequential_target;sample_energy_and_source_branch_draws;use_live_population_mean;apply_declared_six_branch_equations";
        @reads: vocabulary.read_role { (~ states.positions, ~ states.leader, ~ states.energy_factor, ~ states.decision_source, ~ states.target_index); }
        @writes: vocabulary.write_role { (~ states.proposal, ~ states.branch, ~ states.random_record); }
    }
    @evaluate_trial: vocabulary.operator_kind {
        key "hho.evaluate_trial";
        rule "require_count<B;require_finite_and_clamp_trial;charge_objective;do_not_publish_before_parent_comparison";
        @reads: vocabulary.read_role { (~ states.proposal, ~ states.bounds, ~ states.objective, ~ states.evaluation_count, ~ states.budget_limit); }
        @writes: vocabulary.write_role { (~ states.trial_point, ~ states.trial_score, ~ states.evaluated_candidate, ~ states.evaluated_score, ~ states.evaluation_count); }
    }
    @reevaluate_parent: vocabulary.operator_kind {
        key "hho.reevaluate_parent";
        rule "require_count<B;charge_current_parent_again_even_if_cached;record_actual_parent_score";
        @reads: vocabulary.read_role { (~ states.positions, ~ states.target_index, ~ states.bounds, ~ states.objective, ~ states.evaluation_count, ~ states.budget_limit); }
        @writes: vocabulary.write_role { (~ states.parent_score, ~ states.last_scored_population, ~ states.last_scored_scores, ~ states.evaluated_candidate, ~ states.evaluated_score, ~ states.evaluation_count); }
    }
    @levy: vocabulary.operator_kind {
        key "hho.levy";
        rule "only_after_first_trial_rejected_and_budget_remains;draw_D_multipliers_then_D_u_normals_then_D_v_normals;Mantegna_beta_1.5;require_nonzero_divisors";
        @reads: vocabulary.read_role { (~ states.proposal, ~ states.decision_source, ~ states.evaluation_count, ~ states.budget_limit); }
        @writes: vocabulary.write_role { (~ states.proposal, ~ states.random_record); }
    }
    @publish: vocabulary.operator_kind {
        key "hho.publish";
        rule "non_dive_assigns_pending_raw_proposal;dive_assigns_repaired_trial_iff_strictly_better;retain_last_scored_snapshots_for_pending_moves;advance_target;increment_iteration_only_after_complete_sweep";
        @reads: vocabulary.read_role { (~ states.branch, ~ states.proposal, ~ states.trial_point, ~ states.trial_score, ~ states.parent_score, ~ states.iteration, ~ states.population_size, ~ states.target_index, ~ states.positions, ~ states.last_scored_population, ~ states.last_scored_scores); }
        @writes: vocabulary.write_role { (~ states.positions, ~ states.last_scored_population, ~ states.last_scored_scores, ~ states.target_index, ~ states.iteration); }
    }
    @archive: vocabulary.operator_kind {
        key "hho.archive";
        rule "host_after_each_actual_evaluation;strict_improvement_updates_vector;all_calls_count_including_repeated_parents";
        @reads: vocabulary.read_role { (~ states.evaluated_candidate, ~ states.evaluated_score, ~ states.archive_best); }
        @writes: vocabulary.write_role { (~ states.archive_best); }
    }
    @stop: vocabulary.operator_kind {
        key "hho.stop";
        rule "stop_at_B_including_partial_comparison;return_host_archive_and_last_scored_slots;report_completed_cycles_and_phase_progress";
        @reads: vocabulary.read_role { (~ states.evaluation_count, ~ states.budget_limit, ~ states.archive_best, ~ states.last_scored_population, ~ states.last_scored_scores, ~ states.iteration, ~ states.target_index); }
        @writes: vocabulary.write_role { (~ states.run_status); }
    }
}
