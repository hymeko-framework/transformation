// Trace identities are edge IDs, not deduplicated endpoint pairs.
digraph {{config:robot_name}} {
  rankdir=LR;
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
{{#each requirements}}
  "{{name}}" [label="<<requirement>>\n{{name}}", shape=box, style=filled, fillcolor="#fde68a", text="{{field:text}}"];
{{/each}}
{{#each blocks}}
  "{{name}}" [label="<<block>>\n{{name}}", shape=component, style=filled, fillcolor="#bfdbfe"];
{{/each}}
{{#each tests}}
  "{{name}}" [label="<<test_case>>\n{{name}}", shape=ellipse, style=filled, fillcolor="#ddd6fe", outcome="{{field:outcome}}"];
{{/each}}
{{#each satisfies_edges}}
  "{{bind:+:0}}" -> "{{bind:-:0}}" [label="<<satisfy>>", id="{{name}}", color="#16803c"];
{{/each}}
{{#each allocated_edges}}
  "{{bind:+:0}}" -> "{{bind:-:0}}" [label="<<allocate>>", id="{{name}}", color="#be185d"];
{{/each}}
{{#each derives_edges}}
  "{{bind:+:0}}" -> "{{bind:-:0}}" [label="<<deriveReqt>>", id="{{name}}", style=dotted];
{{/each}}
{{#each verifies_edges}}
  "{{bind:+:0}}" -> "{{bind:-:0}}" [label="<<verify>>", id="{{name}}", color="#6d28d9"];
{{/each}}
}
